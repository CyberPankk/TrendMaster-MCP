# ============================================================== 
# 🚀 TrendMaster-MCP 系统环境配置模版 
# ⚠️ 绝密警告：请勿将含有真实秘钥的 .env 文件提交至 GitHub！ 
# ============================================================== 

# -------------------------------------------------------------- 
# 🧠 中枢大脑配置 (Agent Client) 
# -------------------------------------------------------------- 
# 驱动 Agent 推理与调度的核心大模型 API Key
# LLM_PROVIDER=anthropic # 默认使用 Claude
# LLM_PROVIDER=deepseek  # 切换使用 DeepSeek (SiliconFlow)
# LLM_PROVIDER=ofox      # 切换使用 Ofox (GPT-5.4-Mini)

# Anthropic 配置 (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxx 

# Ofox 配置 (GPT-5.4-Mini)
OFOX_API_KEY=your_ofox_api_key_here
OFOX_MODEL=openai/gpt-5.4-mini
OFOX_BASE_URL=https://api.ofox.ai/v1

# -------------------------------------------------------------- 
# 🌐 交易所 API 配置 (Market & Execution MCP) 
# -------------------------------------------------------------- 
# Binance (默认主交易平台) 
# 注意：Market-MCP 建议使用只读 Key，Execution-MCP 必须使用带交易权限的 Key 
BINANCE_API_KEY=your_binance_api_key_here 
BINANCE_SECRET=your_binance_secret_key_here 

# OKX (备用/多所对冲平台) 
OKX_API_KEY=your_okx_api_key_here 
OKX_SECRET=your_okx_secret_key_here 
OKX_PASSPHRASE=your_okx_passphrase_here 

# --------------------------------------------------------------
# 🛡️ 物理沙盒风控配置 (Execution MCP 专用)
# --------------------------------------------------------------
# 将风控参数提取到环境变量，实现不改代码即可动态调控风险
MAX_ORDER_USD=5000       # 单笔最大允许下单金额 (USDT)
MAX_POSITION_USD=20000   # 总仓位硬性熔断上限 (USDT)
MAX_SPREAD_PCT=0.005     # 盘口最大允许滑点价差 (0.5%)

# 算法订单配置 (TWAP)
TWAP_THRESHOLD_USD=2000   # 超过 2000 USDT 自动走算法单 
TWAP_CHUNK_USD=500        # 算法单每次切片金额 500 USDT 
TWAP_INTERVAL_SEC=5       # 切片执行间隔 5 秒 

# ⚠️ 核心安全开关 ⚠️
# True = 沙盒模式（只记录日志，不向交易所发单）
# False = 实盘模式（动用真金白银，请谨慎！）
DRY_RUN_MODE=True 

# -------------------------------------------------------------- 
# 🛠️ 系统运行日志与环境配置 
# -------------------------------------------------------------- 
LOG_LEVEL=INFO           # 可选: DEBUG, INFO, WARNING, ERROR 
ENVIRONMENT=development  # 可选: development, production

# -------------------------------------------------------------- 
# 🌐 网络代理配置 (用于解决 API 访问受限问题) 
# -------------------------------------------------------------- 
# 例如: http://127.0.0.1:7890 (Clash/V2ray 默认本地端口) 
CCXT_PROXY=

# --------------------------------------------------------------
# 🔮 Kronos 本地时间序列预测 (Indicator MCP 专用)
# --------------------------------------------------------------
# True 时服务启动阶段预热本地 Kronos；加载失败会自动退回启发式预测，避免交易链路中断。
KRONOS_ENABLE_LOCAL=true
KRONOS_REQUIRE_LOCAL=true
KRONOS_LOCAL_REPO_PATH=/path/to/Kronos
KRONOS_PYTHON_MODULE=model
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=mps
KRONOS_MAX_CONTEXT=512
KRONOS_LOOKBACK=400
KRONOS_DEFAULT_PRED_LEN=24
KRONOS_LOCAL_TIMEOUT_SECONDS=12
KRONOS_TEMPERATURE=1.0
KRONOS_TOP_P=0.9
KRONOS_SAMPLE_COUNT=1
